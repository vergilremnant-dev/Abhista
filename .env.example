# ==============================================================================
# DBC Abhista - Environment Variables Configuration Template
# Copy this file to .env and provide your deployment secrets.
# NEVER COMMIT .env TO VERSION CONTROL.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Connection (PostgreSQL / Supabase)
# ------------------------------------------------------------------------------
# Pooled connection string for serverless API runtime (Transaction mode / Port 6543 or 5432 with pgbouncer)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require"

# Direct connection string for Prisma migrations (Direct port 5432)
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require"

# ------------------------------------------------------------------------------
# 2. Authentication & Security
# ------------------------------------------------------------------------------
# Cryptographically strong secret key used for signing JWT access and refresh tokens (min 32 characters)
JWT_SECRET="your-strong-random-jwt-secret-min-32-chars"

# Node Environment: 'development' | 'production' | 'test'
NODE_ENV="production"

# ------------------------------------------------------------------------------
# 3. Razorpay Payment Gateway (Server-side)
# ------------------------------------------------------------------------------
# Razorpay Key ID (Client-safe public ID)
RAZORPAY_KEY_ID="rzp_live_xxxxxxxxxxxxxx"

# Razorpay Key Secret (Strictly server-side for order creation and HMAC verification)
RAZORPAY_KEY_SECRET="your-razorpay-key-secret-here"

# ------------------------------------------------------------------------------
# 4. Frontend Configuration (Optional if deployed separately from API)
# ------------------------------------------------------------------------------
# Base API URL if frontend is hosted on a separate domain (leave empty for same-domain Vercel deployment)
# VITE_API_BASE_URL="https://api.yourdomain.com"
